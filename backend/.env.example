# Placeholders only. Never commit real values. Set real values in Render dashboard / local .env
NODE_ENV=development
PORT=10000
# Atlas connection string for a DEDICATED least-privilege user (URL-encode special characters in the password)
MONGODB_URI=
# Explicit database name. Prefer a dedicated "takna_ai" database.
MONGODB_DB_NAME=
# Gemini key. Server-side only.
GEMINI_API_KEY=
# Optional keep-alive self-ping (production only). Render sets RENDER_EXTERNAL_URL automatically.
# KEEP_ALIVE=false turns it off. PING_URL overrides the target base URL.
KEEP_ALIVE=
PING_URL=
# Optional. Default gemini-flash-latest (alias). Change if Google retires a model.
GEMINI_MODEL=
# Optional interim limits (replaced by plan entitlements in Phase 10)
AI_DAILY_REQUESTS=
AI_MAX_OUTPUT_TOKENS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences kept as-is
FIREBASE_PRIVATE_KEY=
# Comma-separated admin panel origins, e.g. https://admin.example.com (no wildcard)
CORS_ORIGINS=
# Email of the first super admin (must sign in with a VERIFIED email). Works on Render Free (no shell needed).
INITIAL_SUPER_ADMIN_EMAIL=
# Min 16 chars. Used only by the one-time `npm run admin:bootstrap` command.
ADMIN_BOOTSTRAP_SECRET=

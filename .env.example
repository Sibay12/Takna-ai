MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/takna
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
